# Normalize text files to LF in the repository.
* text=auto eol=lf

# Shell scripts should stay LF on every platform.
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Common source, config, and documentation files.
*.java text eol=lf
*.groovy text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Keep Windows command files CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

